# ── Core ──
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentdesk
REDIS_URL=redis://localhost:6379
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# openssl rand -base64 32   (encrypts integration credentials at rest)
ENCRYPTION_KEY=
# true = run AI replies/webhooks in the API process (no worker needed). Use false in production.
INLINE_JOBS=true

# ── AI ──
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-5-5

# ── Billing (optional) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# ── Channels (optional) ──
INBOUND_EMAIL_SECRET=
# comma separated emails allowed into /v1/platform (SaaS operator console)
PLATFORM_ADMIN_EMAILS=
